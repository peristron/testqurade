# Copy this structure into Streamlit Community Cloud: App settings > Secrets.
# Never commit a real .streamlit/secrets.toml file.

[auth]
cookie_name = "tfsa_dashboard_auth"
cookie_key = ""
cookie_expiry_days = 1

[auth.credentials.usernames.omar]
email = "you@example.com"
name = "Omar"
# Generate a bcrypt hash using the command documented in README.md.
password = "$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH"

[questrade]
refresh_token = ""

[deepseek]
api_key = ""
model = "deepseek-v4-flash"
# base_url = "https://api.deepseek.com"

[glm]
api_key = ""
model = "glm-4.7-flash"
# base_url = "https://api.z.ai/api/paas/v4"

[mistral]
api_key = ""
model = "mistral-small-latest"
# base_url = "https://api.mistral.ai/v1"

[cohere]
api_key = ""
model = "command-a-plus-05-2026"
# base_url = "https://api.cohere.com/v2"

[sealion]
api_key = ""
model = "aisingapore/Gemma-SEA-LION-v4-27B-IT"
# base_url = "https://api.sea-lion.ai/v1"

[tavily]
api_key = ""
